{
  "id": "python",
  "name": "Python",
  "kind": "language",
  "schema": 1,
  "ext": [".py", ".pyw"],
  "editor": "python",
  "requires": ["{python}"],
  "run": { "cmd": "{python}", "args": ["-u", "{file}"] },
  "env": {
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8",
    "PYTHONUNBUFFERED": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "timeout": 10
}
